# libhybris userspace bridge for Android hardware on Samsung Galaxy A04e
pkgname=libhybris-a04e
pkgver=0.1
pkgrel=1
pkgdesc="libhybris Android hardware compatibility bridge for A04e"
arch="aarch64"
url="https://github.com/libhybris/libhybris"
license="LGPL-2.1-or-later"
options="!check !archcheck"
depends="android-headers-halium-a04e"
makedepends="
	android-headers-halium-a04e
	autoconf
	automake
	libtool
	pkgconf
	linux-headers
	libx11-dev
	mesa-dev
	wayland-dev
"
_source_commit="7079712a42ea2754adf747e70c6cc75764c8596e"
source="libhybris-$_source_commit.tar.gz::https://github.com/libhybris/libhybris/archive/$_source_commit.tar.gz"
builddir="$srcdir/libhybris-$_source_commit"

build() {
	./autogen.sh
	./configure --build=aarch64-linux-musl --host=aarch64-linux-musl --enable-arch=arm64 --with-android-headers=/usr/include/android --prefix=/usr --enable-experimental --enable-wayland
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
SKIP  libhybris-$_source_commit.tar.gz
"
